{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/ios-launch-proof.schema.json",
  "title": "Travel Planner iOS Home Screen launch proof",
  "type": "object",
  "required": [
    "schemaVersion",
    "schemaUrl",
    "type",
    "app",
    "standalone",
    "displayMode",
    "serviceWorker",
    "path",
    "url",
    "capturedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "schemaUrl": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "ios-home-screen-launch-proof"
    },
    "app": {
      "const": "travel-planner-web"
    },
    "standalone": {
      "const": true
    },
    "displayMode": {
      "const": "standalone"
    },
    "serviceWorker": {
      "enum": [
        "controlled",
        "supported-uncontrolled",
        "unsupported"
      ]
    },
    "appShell": {
      "type": "string"
    },
    "serverShell": {
      "type": "string"
    },
    "appShellUpdateNeeded": {
      "type": "boolean"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "iosDevice": {
      "type": "boolean"
    },
    "iosSafari": {
      "type": "boolean"
    },
    "appleWebAppTitle": {
      "type": "string"
    },
    "manifestUrl": {
      "type": "string",
      "format": "uri"
    },
    "themeColor": {
      "type": "string"
    },
    "screenWidth": {
      "type": "integer",
      "minimum": 1
    },
    "screenHeight": {
      "type": "integer",
      "minimum": 1
    },
    "devicePixelRatio": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appModeState": {
      "enum": [
        "standalone",
        "safari",
        "browser"
      ]
    },
    "appModeTitle": {
      "type": "string"
    },
    "appModeDetail": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
