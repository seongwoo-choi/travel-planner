{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/ios-install-session-check.schema.json",
  "title": "Travel Planner iOS install session check result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "ok",
    "status",
    "sourceUrl",
    "httpStatus",
    "recoveryUrl",
    "recoveryTriggerField",
    "recoveryTriggerValue",
    "recoverySequenceCount",
    "postInstallAppHomeUrl",
    "postInstallNewPlanUrl",
    "handoffEvidenceCommand",
    "handoffEvidenceTerminalCommand",
    "sessionEvidenceCommand",
    "sessionEvidenceTerminalCommand",
    "handoffSessionEvidenceCommand",
    "handoffSessionEvidenceTerminalCommand",
    "finalGateCommand",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": ["ready", "blocked"]
    },
    "sourceUrl": {
      "type": "string"
    },
    "httpStatus": {
      "type": "integer",
      "minimum": 0
    },
    "recoveryUrl": {
      "type": "string"
    },
    "recoveryTriggerField": {
      "type": "string"
    },
    "recoveryTriggerValue": {
      "type": "boolean"
    },
    "recoverySequenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "postInstallAppHomeUrl": {
      "type": "string"
    },
    "postInstallNewPlanUrl": {
      "type": "string"
    },
    "handoffEvidenceCommand": {
      "const": "npm run ios:install:handoff:evidence"
    },
    "handoffEvidenceTerminalCommand": {
      "const": "test -d webapp && cd webapp; npm run ios:install:handoff:evidence"
    },
    "sessionEvidenceCommand": {
      "const": "npm run ios:install:session:evidence"
    },
    "sessionEvidenceTerminalCommand": {
      "const": "test -d webapp && cd webapp; npm run ios:install:session:evidence"
    },
    "handoffSessionEvidenceCommand": {
      "const": "npm run ios:install:handoff-session:evidence"
    },
    "handoffSessionEvidenceTerminalCommand": {
      "const": "test -d webapp && cd webapp; npm run ios:install:handoff-session:evidence"
    },
    "finalGateCommand": {
      "const": "npm run ios:install:evidence:after-phone:final"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
