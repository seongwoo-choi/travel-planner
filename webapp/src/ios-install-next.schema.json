{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/ios-install-next.schema.json",
  "title": "Travel Planner iPhone install next step",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "action",
    "title",
    "commands",
    "installTarget",
    "installStart",
    "sessionCheck",
    "reports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "run-before-phone",
        "install-on-phone",
        "run-final-gate",
        "complete"
      ]
    },
    "title": {
      "type": "string"
    },
    "nextCommand": {
      "type": "string"
    },
    "nextTerminalCommand": {
      "type": "string"
    },
    "nextCommandLabel": {
      "type": "string"
    },
    "nextCommandPrerequisite": {
      "type": "string"
    },
    "phoneFirst": {
      "type": "boolean"
    },
    "phoneStep": {
      "type": "string"
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "installTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "installUrl",
        "shortInstallUrl",
        "qrUrl",
        "proofSaveHash",
        "proofSaveTargetId",
        "proofSaveUrl"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "installUrl": {
          "type": "string"
        },
        "shortInstallUrl": {
          "type": "string"
        },
        "qrUrl": {
          "type": "string"
        },
        "proofSaveHash": {
          "const": "#iosInstallProofSaveButton"
        },
        "proofSaveTargetId": {
          "const": "iosInstallProofSaveButton"
        },
        "proofSaveUrl": {
          "type": "string"
        }
      }
    },
    "installStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "state",
        "path",
        "modifiedAt",
        "freshnessState",
        "freshnessAgeHours",
        "freshnessStaleAfterHours",
        "readiness",
        "warning",
        "recommendedShortInstallUrl",
        "recommendedInstallUrl",
        "sessionQrUrl",
        "nextActionBoardUrl",
        "proofSaveHash",
        "proofSaveTargetId",
        "proofSaveUrl",
        "postInstallAppHomeUrl",
        "postInstallNewPlanUrl",
        "appHomeFirstPlanUrl",
        "beforePhoneTerminalCommand",
        "beforePhoneFinalTerminalCommand",
        "beforePhoneFinalThenNextTerminalCommand",
        "afterPhoneThenAllTerminalCommand",
        "afterPhoneThenAllFinalTerminalCommand",
        "stepCount",
        "recommendedAction",
        "recommendedCommand"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "modifiedAt": {
          "type": "string"
        },
        "freshnessState": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "freshnessAgeHours": {
          "type": [
            "number",
            "null"
          ]
        },
        "freshnessStaleAfterHours": {
          "type": "number"
        },
        "readiness": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "recommendedShortInstallUrl": {
          "type": "string"
        },
        "recommendedInstallUrl": {
          "type": "string"
        },
        "sessionQrUrl": {
          "type": "string"
        },
        "nextActionBoardUrl": {
          "type": "string"
        },
        "proofSaveHash": {
          "type": "string"
        },
        "proofSaveTargetId": {
          "type": "string"
        },
        "proofSaveUrl": {
          "type": "string"
        },
        "postInstallAppHomeUrl": {
          "type": "string"
        },
        "postInstallNewPlanUrl": {
          "type": "string"
        },
        "appHomeFirstPlanUrl": {
          "type": "string"
        },
        "beforePhoneTerminalCommand": {
          "type": "string"
        },
        "beforePhoneFinalTerminalCommand": {
          "type": "string"
        },
        "beforePhoneFinalThenNextTerminalCommand": {
          "type": "string"
        },
        "afterPhoneThenAllTerminalCommand": {
          "type": "string"
        },
        "afterPhoneThenAllFinalTerminalCommand": {
          "type": "string"
        },
        "stepCount": {
          "type": "number"
        },
        "recommendedAction": {
          "type": "string"
        },
        "recommendedCommand": {
          "type": "string"
        }
      }
    },
    "sessionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "state",
        "path",
        "modifiedAt",
        "status",
        "recoveryUrl",
        "recoveryTriggerField",
        "recoveryTriggerValue",
        "recoverySequenceCount",
        "finalGateCommand",
        "issueCount",
        "recommendedCommand",
        "recommendedNpmScript"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "modifiedAt": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "recoveryUrl": {
          "type": "string"
        },
        "recoveryTriggerField": {
          "type": "string"
        },
        "recoveryTriggerValue": {
          "type": "boolean"
        },
        "recoverySequenceCount": {
          "type": "number"
        },
        "finalGateCommand": {
          "type": "string"
        },
        "issueCount": {
          "type": "number"
        },
        "recommendedCommand": {
          "type": "string"
        },
        "recommendedNpmScript": {
          "type": "string"
        }
      }
    },
    "reports": {
      "type": "object"
    }
  }
}
