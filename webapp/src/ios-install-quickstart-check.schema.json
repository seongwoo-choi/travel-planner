{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/ios-install-quickstart-check.schema.json",
  "title": "Travel Planner iOS install quickstart check result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "status",
    "summary",
    "inputPath",
    "urlOrigin",
    "urlSameOrigin",
    "proofSaveHash",
    "proofSaveTargetId",
    "proofSaveUrl",
    "postInstallAppHomeUrl",
    "postInstallNewPlanUrl",
    "completionStatusUrl",
    "prepareCommand",
    "statusCommand",
    "finishCommand",
    "stepCount",
    "recoveryHintCount",
    "issues"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "type": "boolean" },
    "status": {
      "enum": ["ready", "invalid", "missing", "invalid-json"]
    },
    "summary": { "type": "string" },
    "inputPath": { "type": "string" },
    "urlOrigin": { "type": "string" },
    "urlSameOrigin": { "type": "boolean" },
    "proofSaveHash": { "const": "#iosInstallProofSaveButton" },
    "proofSaveTargetId": { "const": "iosInstallProofSaveButton" },
    "proofSaveUrl": { "type": "string" },
    "postInstallAppHomeUrl": { "type": "string" },
    "postInstallNewPlanUrl": { "type": "string" },
    "completionStatusUrl": { "type": "string" },
    "prepareCommand": { "const": "npm run ios:install:prepare" },
    "statusCommand": { "const": "npm run ios:install:status" },
    "finishCommand": { "const": "npm run ios:install:finish" },
    "stepCount": {
      "type": "integer",
      "minimum": 0
    },
    "recoveryHintCount": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
