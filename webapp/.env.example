PORT=3000
TRAVEL_DB_PATH=data/plans.sqlite
# 필수. 미설정 시 health/status 외 웹 /api/* 요청은 fail-closed(503)됩니다. Discord 봇은 영향 없음.
TRAVEL_ACCESS_KEY=
# 공유 웹앱 최소 보호 조합:
# - TRAVEL_ACCESS_KEY로 웹 API 접근을 보호
# - TRAVEL_REQUIRE_USER_LLM_KEY=true로 웹 생성/고도화에서 운영자 LLM 키 fallback 차단
# 예:
# TRAVEL_ACCESS_KEY=공유_접근키
# TRAVEL_REQUIRE_USER_LLM_KEY=true
# Discord 응답의 "웹 상세" 버튼에 사용할 웹앱 기준 URL.
# 다른 기기에서 열 수 있는 배포 URL 또는 같은 Wi-Fi의 http://맥IP:3000 값을 넣으세요.
TRAVEL_PUBLIC_BASE_URL=
# health API checker가 public base와 다른 endpoint를 점검해야 할 때만 설정하세요.
# 비우면 TRAVEL_PUBLIC_BASE_URL + /api/health.txt 또는 localhost health endpoint를 사용합니다.
TRAVEL_HEALTH_URL=
# health API checker timeout(ms). 너무 낮게 잡으면 네트워크 환경에서 오탐이 날 수 있습니다.
TRAVEL_HEALTH_TIMEOUT_MS=5000
# 진단 로그가 필요할 때 1로 설정하면 target/status/elapsed를 stderr에 남깁니다.
TRAVEL_HEALTH_EVIDENCE=0
# protected API fetch helper timeout(ms). API가 느린 터널/VPN 뒤에 있으면 늘리세요.
TRAVEL_API_FETCH_TIMEOUT_MS=5000
# protected API fetch 진단 로그가 필요할 때 1로 설정하면 target/status/elapsed/header mode를 stderr에 남깁니다.
TRAVEL_API_FETCH_EVIDENCE=0
# 백업 워크플로 출력 폴더. 비우면 reports를 사용합니다.
TRAVEL_EVIDENCE_DIR=reports
# 백업/복구 evidence manifest 저장/검증 경로. 비우면 각 명령의 기본값을 사용합니다.
TRAVEL_BACKUP_FILE_PATH=
TRAVEL_BACKUP_FILE_CHECK_PATH=
TRAVEL_BACKUP_MANIFEST_PATH=
TRAVEL_BACKUP_MANIFEST_VERIFY_PATH=
TRAVEL_BACKUP_VERIFY_PATH=
# /quick에서 "7월 1일"처럼 연도 없는 날짜를 해석할 때 사용할 기본 연도
TRAVEL_DEFAULT_YEAR=

# Grounded planner data providers. Google Geocoding, Places API (New),
# Distance Matrix API가 활성화된 같은 Google Maps Platform 키를 사용합니다.
GOOGLE_MAPS_API_KEY=

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Discord 접근 설정은 /whoami와 설정 버튼으로 확인할 수 있습니다.
# /start, /whoami, /policy, /recover는 allowlist 설정 전에도 시작/ID/복구 확인용으로 응답합니다.
# 빠른 테스트는 서버/길드 ID 지정 권장. 비우면 global command로 등록되어 반영이 늦을 수 있음.
DISCORD_GUILD_ID=
# 필수(서버 사용 시). 미설정 시 복구용 명령 외에는 fail-closed됩니다. 서버 ID는 /whoami로 확인하세요.
# 예: DISCORD_ALLOWED_GUILD_IDS=123456789012345678,234567890123456789
DISCORD_ALLOWED_GUILD_IDS=
# 선택 사항. true로 설정하면 DM에서도 봇이 응답합니다. 개인용이면 DISCORD_ALLOWED_USER_IDS와 함께 쓰세요.
DISCORD_ALLOW_DM=false
# 필수. 미설정 시 복구용 명령 외에는 fail-closed됩니다. 내 ID는 /whoami로 확인하세요.
# 예: DISCORD_ALLOWED_USER_IDS=123456789012345678,234567890123456789
DISCORD_ALLOWED_USER_IDS=
# 선택 사항. 설정하면 /ops, /doctor 같은 운영 명령을 해당 Discord user ID들로 제한합니다. 내 ID는 /whoami로 확인하세요.
# 예: DISCORD_ADMIN_USER_IDS=123456789012345678,234567890123456789
DISCORD_ADMIN_USER_IDS=

# codex | claude | mock | auto
LLM_PROVIDER=auto
# codex/claude 모두 지원. codex는 OpenAI 호환 API, claude는 Anthropic 형식 API를 사용.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=gpt-4o-mini
# 공통 키: codex는 OPENAI_API_KEY 또는 LLM_API_KEY, claude는 CLAUDE_API_KEY 또는 LLM_API_KEY 사용
OPENAI_API_KEY=
CLAUDE_API_KEY=
# Anthropic 기본 환경변수 이름을 선호하면 CLAUDE_API_KEY 대신 사용 가능
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307
LLM_API_KEY=
# 공유 웹앱에서 운영자 키 과금을 막고 사용자 1회용 provider API key를 필수로 요구하려면 true
# true이면 웹의 새 플랜 생성/고도화 요청은 요청 본문의 llmProvider + llmApiKey가 필요합니다.
# Discord 봇은 별도 allowlist와 LLM env 설정을 사용합니다.
TRAVEL_REQUIRE_USER_LLM_KEY=false
TRAVEL_API_RATE_LIMIT_MAX=120
TRAVEL_API_RATE_LIMIT_WINDOW_MS=60000
# travel plan 생성 기준 스킬(옵션). 기본은 .claude/skills/travel-orchestrator/SKILL.md
TRAVEL_ORCHESTRATOR_PATH=
